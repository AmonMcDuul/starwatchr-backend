# Development: SMTP credentials stay in api/appsettings.Development.json.
# Start the .NET API on its existing HTTP profile (localhost:5016).
SITE_URL=http://localhost:4200
NOTIFICATIONS_API_URL=http://localhost:4200/notifications-api
MAIL_SERVICE_URL=http://localhost:5016/internal/notification-mail
NOTIFICATION_MODE=live
# The dev runner generates and shares a local MAIL_SERVICE_KEY automatically.

# Separate read-only key for SW-Analytics. Generate 32+ random characters.
NOTIFICATIONS_ANALYTICS_KEY=

# Wake the Free API only before mail delivery (default: true).
MAIL_SERVICE_WAKE_ENABLED=true

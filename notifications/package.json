{
  "name": "starwatchr-notifications",
  "version": "1.0.0",
  "private": true,
  "main": "dist/functions.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/verify-engine.cjs && tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "npm run build && func start",
    "test:local": "npm run build && node dist/local.js --capture",
    "dev": "npm run build && node dist/local.js",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.cjs\" \"*.json\""
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.0",
    "@azure/functions": "^4.7.0",
    "@azure/storage-queue": "^12.27.0",
    "astronomy-engine": "2.1.19",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "azurite": "^3.35.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.2"
  }
}

{
  "version": "2.0",
  "functionTimeout": "00:05:00",
  "extensions": {
    "queues": {
      "batchSize": 4,
      "newBatchThreshold": 2,
      "visibilityTimeout": "00:02:00",
      "maxDequeueCount": 8,
      "messageEncoding": "base64"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}
